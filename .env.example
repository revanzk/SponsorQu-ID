# ── AI Provider (OpenAI-compatible) ───────────────────────────────────────────
# provider: openai | gemini | ollama
# 9router lokal memakai mode openai + base URL di bawah.
LLM_PROVIDER=openai
LLM_BASE_URL=http://localhost:20128/v1
# Sesuaikan dengan nama model yang tersedia di 9router kamu.
LLM_MODEL=grok-4.20-fast
# Kosongkan jika provider tidak butuh key (mis. ollama).
LLM_API_KEY=

# Generasi
LLM_TEMPERATURE_SEARCH=0.2
LLM_TEMPERATURE_DRAFT=0.1
LLM_TIMEOUT_MS=60000
LLM_SEARCH_ATTEMPTS=2
LLM_CONCURRENCY=3

# Katalog sponsor: catalog (kirim semua sponsor) | bm25 (pre-filter top-N lokal)
LLM_CATALOG_MODE=catalog
LLM_CATALOG_MAX_CHARS=100000
LLM_BM25_TOP=20

# ── Composio (Gmail) ─────────────────────────────────────────────────────────
COMPOSIO_API_KEY=
COMPOSIO_GMAIL_AUTH_CONFIG_ID=ac_Im0mILtarfgb
COMPOSIO_GMAIL_VERSION=20260915_00

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000
COMPOSIO_PORT=5000

# ── Frontend (Vite) ──────────────────────────────────────────────────────────
VITE_BACKEND_URL=http://localhost:5000
VITE_DEBUG_AI=false
